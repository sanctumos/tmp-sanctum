<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SanctumShare" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/sanctum_primary</item>
        <item name="colorSecondary">@color/sanctum_secondary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:statusBarColor">@color/sanctum_primary</item>
        <item name="android:navigationBarColor">@color/sanctum_bg</item>
        <item name="android:windowBackground">@color/sanctum_bg</item>
        <item name="android:textColorPrimary">@color/sanctum_ink</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="materialButtonStyle">@style/Widget.SanctumShare.Button</item>
    </style>

    <style name="Widget.SanctumShare.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/sanctum_primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">10dp</item>
    </style>
</resources>
